# SMTP account used by Nodemailer to send contact-form emails.
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=farazzaveri26@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact-form messages are delivered
CONTACT_TO=farazzaveri26@gmail.com
